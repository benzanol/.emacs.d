(bz/package echo-bar)(bz/require functions)(setq echo-bar-update-interval 1      echo-bar-right-padding 0);; (bz/face bz/echo-bar :h 1.0);; (bz/face bz/echo-bar :family "TeX Gyre Heros Cn" :h 1.05)(bz/face bz/echo-bar :family "TeX Gyre Adventor" :h 1.00);; (setq echo-bar-function 'bz/echo-bar-function-fancy)(setq echo-bar-function 'bz/echo-bar-function-minimal);;; Minimal(defun bz/tallies (num &optional pad)  (if (eq num 0) ""    (propertize     (if (>= num 5)         (concat (propertize "││││" 'face 'shr-strike-through)                 (if (eq num 5) "" " ")                 (bz/tallies (- num 5)))       (s-pad-right (if pad 4 num) " " (make-string num ?│)))     'display '(height 0.7))))(defun bz/number-to-turtle (num)  (mapconcat   (lambda (char)     (propertize "." 'display                 (create-image (format "~/Media/Turtles/%s.png" char)                               nil nil :height 40)))   (split-string (number-to-string num) "" t)   ""   )  )(defun bz/prime-time ()  (interactive)  (setq bz/time-number-func (lambda (n) (bz/primes n #'org-export-number-to-roman #'bz/tallies))))(defun bz/tally-time ()  (interactive)  (setq bz/time-number-func (lambda (n) (bz/tallies n t))))(defun bz/turtle-time ()  (interactive)  (setq bz/time-number-func #'bz/number-to-turtle))(defun bz/number-to-string-2 (num) (format "%02d" num))(defun bz/number-time ()  (interactive)  (setq bz/time-number-func #'bz/number-to-string-2))(setq bz/time-number-func #'bz/number-to-string-2)(setq bz/date-number-func #'number-to-string)(defun bz/echo-bar-function-minimal ()  ;; It keep stopping for some reason  (run-with-timer 0.5 nil #'timer-activate echo-bar-timer)  (bz/add-face   (string-join    (list (bz/activity-string)          (nth (1- bz/cpu-level) bz/cpu-level-names)          (bz/battery-format)          (concat           (format-time-string "%a %b ")           (funcall bz/date-number-func (string-to-number (format-time-string "%d"))))          ;; (format-time-string "%H:%M:%S")          (concat           (funcall bz/time-number-func (string-to-number (format-time-string "%H")))           ":"           (funcall bz/time-number-func (string-to-number (format-time-string "%M")))           ":"           (funcall bz/time-number-func (string-to-number (format-time-string "%S")))           )          )    " · ")   ;; 'bz/echo-bar   ;; 'italic   ));;; Fancy(setq bz/echo-bar-height 1.4)(defun bz/echo-bar-function-fancy ()  (bz/add-face   (format    "%s%s%s   ǀ   %s   ǀ   %s"    "" ;; (propertize " " 'display `(height ,bz/echo-bar-height))    (if bz/recording-mode "🔴    " "")    (or (ignore-errors (bz/activity-string)) "")    ;; #("" 0 1 (face bold))    ;; (recursion-depth)    (or (ignore-errors (bz/battery-format)) "")    ;; #(" " ;; 0 1 (face (:family "all-the-icons"))    ;; )    ;; ""    ;; #("" 0 1 (display (raise -0.1)))    (format-time-string "%b %d ⁃ %H:%M:%S")    )   'bz/echo-bar   ));;; Battery;; (setq bz/battery-icons;;       '((90 "󱊣 " "󱊦 ");;         (50 "󱊢 " "󱊥 ");;         (15 "󱊡 " "󱊤 ");;         (0  "󱊡 " "󰢟 ")))(setq bz/battery-icons      '((90 " " "󱐋")        (70 " " "󱐋")        (40 " " "󱐋")        (10 " " "󱐋")        (0  " " "󱐋")))(require 'battery)(setq bz/battery-format-func nil)(defun bz/battery-format ()  (when-let* ((status (funcall battery-status-function))              (percent (round (string-to-number (battery-format "%p" status))))              (power-method (battery-format "%L" status)))    (format #("%s %s" 2 3 (display (space :width (5)))) ; Decrease space between percent and icon            (funcall (or bz/battery-format-func #'identity) percent)            (nth (if (member power-method '("AC" "on-line")) 2 1)                 (--find (>= (max percent 0) (car it)) bz/battery-icons)))));;; Activities;; :offset means add an invisible space to make it align with the other icons;; :bold menas make it bold and add a space after it;; :icon means give it the 'all-the-icons' font family(setq bz/activity-icon-alist      '((default "")        (sys "")        (browser "󰈹")        (firefox "󰈹")        (notes "󰠮")        (mail "")        (discord "")        (emacs "")        (minecraft "󰍳")        (mine "󰍳")        (rust "")        (scala "")        (python "")        (py "")        (js "")        (javascript "")        (typescript "")        (lua "")        (test "")))(defun bz/activity-string ()  (let* ((activity (car bz/current-activity))         (icon (car (alist-get (intern (downcase (car (split-string activity ":"))))                               bz/activity-icon-alist)))         (number (car (rassoc activity bz/activity-numbers))))    (format "%s%s  %s"            (if (not number) "" (bz/add-face (format "(%s)  " number) 'shadow))            (or icon "") activity)))