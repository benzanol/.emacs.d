;; -*- lexical-binding: t; -*-(require 'bz-base)(require 'bz-functions)(require 'all-the-icons)(require 'battery)(require 'ox)(require 's)(add-to-list 'load-path "~/.emacs.d/my-packages/echo-bar.el")(require 'echo-bar)(run-with-timer nil 30 #'echo-bar-enable);; (cancel-function-timers 'echo-bar-enable);; (require 'wosp)(setq echo-bar-update-interval 1)(setq echo-bar-right-padding 2)(setq echo-bar-per-frame t);; (bz/face bz/echo-bar :h 1.0);; (bz/face bz/echo-bar :family "TeX Gyre Heros Cn" :h 1.05)(bz/face bz/echo-bar :family "TeX Gyre Adventor" :h 1.00);; (setq echo-bar-function 'bz/echo-bar-function-fancy)(setq echo-bar-function 'bz/echo-bar-function-minimal);;; Times(defun bz/tallies (num &optional pad)  (if (eq num 0) ""    (propertize     (if (>= num 5)         (concat (propertize "││││" 'face 'shr-strike-through)                 (if (eq num 5) "" " ")                 (bz/tallies (- num 5)))       (s-pad-right (if pad 4 num) " " (make-string num ?│)))     'display '(height 0.7))))(defun bz/number-to-turtle (num)  (mapconcat   (lambda (char)     (propertize "." 'display                 (create-image (format "~/Media/Turtles/%s.png" char)                               nil nil :height 40)))   (split-string (number-to-string num) "" t)   ""   )  )(defvar bz/time-number-func nil)(defvar bz/date-number-func nil)(defun bz/prime-time ()  (interactive)  (setq bz/time-number-func (lambda (n) (bz/primes n #'org-export-number-to-roman #'bz/tallies))))(defun bz/tally-time ()  (interactive)  (setq bz/time-number-func (lambda (n) (bz/tallies n t))))(defun bz/turtle-time ()  (interactive)  (setq bz/time-number-func #'bz/number-to-turtle))(defun bz/number-to-string-2 (num) (format "%02d" num))(defun bz/number-time ()  (interactive)  (setq bz/time-number-func #'bz/number-to-string-2))(setq bz/time-number-func #'bz/number-to-string-2)(setq bz/date-number-func #'number-to-string);;; Minimal(defvar bz/last-recursion-depth (recursion-depth))(bz/hook post-command-hook bz/recursion-depth-update-minibuffer  (unless (eq bz/last-recursion-depth (recursion-depth))    (setq bz/last-recursion-depth (recursion-depth))    (echo-bar-update)))(bz/face bz/echo-bar-recursion-depth :light:fg "DarkGoldenrod" :fg "yellow1" :w bold)(bz/face bz/debug-on-error :fg orange :w bold)(defun bz/echo-bar-function-minimal ()  ;; It keep stopping for some reason  ;; (run-with-timer 0.5 nil #'timer-activate echo-bar-timer)  (let ((inhibit-read-only t))    (or (ignore-errors          (bz/add-face           (string-join            (seq-filter             #'identity             (list (when (bound-and-true-p bz/recording-mode) "🔴")                   (when debug-on-error                     (propertize (format "[%s ]" (all-the-icons-nerd-cod "debug" :v-adjust 0.0))                                 'face 'bz/debug-on-error))                   (when (> (recursion-depth) 0)                     (propertize (format "=%s=" (make-string (recursion-depth) ?⭮))                                 'face 'bz/echo-bar-recursion-depth))                   (bz/pro-string)                   ;; (nth (1- bz/cpu-level) bz/cpu-level-names)                   (bz/battery-format)                   (concat                    (format-time-string "%a %b ")                    (funcall bz/date-number-func (string-to-number (format-time-string "%d"))))                   ;; (format-time-string "%H:%M:%S")                   (concat                    (funcall bz/time-number-func (string-to-number (format-time-string "%H")))                    ":"                    (funcall bz/time-number-func (string-to-number (format-time-string "%M")))                    ":"                    (funcall bz/time-number-func (string-to-number (format-time-string "%S")))                    )                   ))            " · "            )           ;; 'bz/echo-bar           ;; 'italic           ))        "error")));;; Fancy(defvar bz/echo-bar-height 1.4)(defun bz/echo-bar-function-fancy ()  (bz/add-face   (format    "%s%s   ǀ   %s   ǀ   %s"    "" ;; (propertize " " 'display `(height ,bz/echo-bar-height))    (if (bound-and-true-p bz/recording-mode) "🔴    " "")    ;; #("" 0 1 (face bold))    ;; (recursion-depth)    (or (ignore-errors (bz/battery-format)) "")    ;; #(" " ;; 0 1 (face (:family "all-the-icons"))    ;; )    ;; ""    ;; #("" 0 1 (display (raise -0.1)))    (format-time-string "%b %d ⁃ %H:%M:%S" nil "GMT+6")    )   'bz/echo-bar   ));;; Battery;; (setq bz/battery-icons;;       '((90 "󱊣 " "󱊦 ");;         (50 "󱊢 " "󱊥 ");;         (15 "󱊡 " "󱊤 ");;         (0  "󱊡 " "󰢟 ")))(defvar bz/battery-icons  '((90 " " "󱐋")    (70 " " "󱐋")    (40 " " "󱐋")    (10 " " "󱐋")    (0  " " "󱐋")))(defvar bz/battery-format-func nil)(defvar bz/echo-bar-battery-time nil  "Last time the battery was checked (seconds)")(defvar bz/echo-bar-battery-status nil)(defun bz/battery-format ()  (when (or (null bz/echo-bar-battery-time)            (null bz/echo-bar-battery-status)            (< 30 (- (float-time) bz/echo-bar-battery-time))            (eq (round (string-to-number (battery-format "%p" bz/echo-bar-battery-status))) 0))    (setq bz/echo-bar-battery-time (time-to-seconds)          bz/echo-bar-battery-status (funcall battery-status-function)))  (let ((percent (round (string-to-number (battery-format "%p" bz/echo-bar-battery-status))))        (method (battery-format "%L" bz/echo-bar-battery-status)))    (format #("%s %s" 2 3 (display (space :width (5)))) ; Decrease space between percent and icon            percent            (nth (if (member method '("AC" "on-line")) 2 1)                 (--find (>= (max percent 0) (car it)) bz/battery-icons)))));;; Wosp(bz/face bz/wosp-key :fg purple :w bold)(defun bz/pro-string ()  (let* ((wosp (wosp-get nil t))         (screen (when wosp (wosp--get-screen wosp)))         (w-key (plist-get wosp :key))         (s-key (when screen (wosp--screen-key wosp screen))))    (if (null wosp) ""      (format "%s %s %s %s"              (propertize (if w-key (format "<%s>" (string w-key)) "")                          'face 'bz/wosp-key)              (wosp-icon-string wosp)              (plist-get wosp :name)              ;; (if (null p-key) "" (propertize (format "[%s]" (string p-key))              ;;                                 'face 'font-lock-keyword-face))              (bz/add-face               (format "[%s%s%s]"                       (bz/add-face (substring (plist-get screen :name)) 'italic)                       (if (null s-key) "" (format "@%s" (string s-key)))                       (if (not (plist-get screen :pinned)) ""                         (format " %s" (all-the-icons-faicon "thumb-tack" :v-adjust -0.15))))               'shadow)))));;; Provide(provide 'bz-echobar)